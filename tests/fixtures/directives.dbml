//@title Directive Test
//@area Core #3a6e6a
//@area Audit #7d3b3b
//@hub users #0000ff
//@hub events #ff0000

TableGroup Core {
  users
  sessions
}

TableGroup Audit {
  events
  event_metadata
}

//@category important
Table users {
  id bigint [pk, increment]
  email varchar(255) [unique, not null]
}

Table sessions {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token varchar(64) [unique, not null]
}

//@category reference_dynamic
//@new
Table events {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  type varchar(100) [not null]
  created_at timestamp [not null]
}

//@category entity_detail
Table event_metadata {
  event_id bigint [not null, ref: > events.id]
  key varchar(100) [not null]
  value text
}
