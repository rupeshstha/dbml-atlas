Table memberships {
  org_id bigint [not null]
  user_id bigint [not null]
  role varchar(50)
  joined_at timestamp

  indexes {
    (org_id, user_id) [pk]
  }
}

Table organizations {
  id bigint [pk, increment]
  name varchar(255) [not null]
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [unique, not null]
}

Ref: memberships.org_id > organizations.id
Ref: memberships.user_id > users.id
